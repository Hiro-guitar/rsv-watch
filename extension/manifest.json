{
  "manifest_version": 3,
  "name": "予約監視 ログイン自動更新",
  "version": "1.1.0",
  "description": "予約ページの証明書（LINEログイン）が切れる前に、Chromeのログイン状態を使って取り直し、GASへ送ります。",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://rsv.e-ticket.link/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://access.line.me/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://rsv.e-ticket.link/*"
      ],
      "js": [
        "page_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rsv.e-ticket.link/*"
      ],
      "js": [
        "page_isolated.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://access.line.me/oauth2/*"
      ],
      "js": [
        "line_login.js"
      ],
      "run_at": "document_idle"
    }
  ]
}